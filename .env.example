# ==================== 智谱 AI ====================
ZHIPU_API_KEY=你自己的API_KEY
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4/

# ==================== Redis（可选）====================
REDIS_URL=redis://localhost:6379/0

# ==================== 模型路径（按你本机实际修改）====================
# Embedding 模型（中文推荐 m3e-large）
EMBEDDING_MODEL=D:/model/m3e-large

# 重排序模型
RERANKER_MODEL=D:/model/bge-reranker-large

# 安全模型
SAFETY_MODEL=D:/model/Unified_Prompt_Guard
SAFETY_MODEL_ENABLED=true

# FAISS 索引存放位置
FAISS_INDEX_DIR=D:/FAISS/faiss_db
PARENT_FAISS_DIR=D:/FAISS/faiss_parent_db

# ==================== 分类过滤开关 ====================
ENABLE_CATEGORY_FILTER=true
CATEGORY_FILTER_RECALL_MULTIPLIER=3
CATEGORY_FILTER_MIN_RESULTS=2